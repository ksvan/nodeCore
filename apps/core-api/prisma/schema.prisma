generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ProductVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ComponentType {
  COVERAGE
  EXPOSURE
  RULE
}

enum ComponentVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum PricingProgramVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum CurrencyCode {
  SEK
  DKK
  EUR
  GBP
  USD
  NOK
}

enum PolicyStatus {
  DRAFT
  ACTIVE
}

enum PolicyTransactionType {
  NEW_BUSINESS
  ENDORSEMENT
}

enum PolicyTransactionStatus {
  DRAFT
  COMMITTED
}

enum PolicyTermStatus {
  ACTIVE
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  roles        String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id          String          @id @default(uuid()) @db.Uuid
  productCode String          @unique
  name        String
  description String?
  status      ProductStatus   @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    ProductVersion[]
}

model ProductVersion {
  id                      String                     @id @default(uuid()) @db.Uuid
  productId               String                     @db.Uuid
  version                 Int
  status                  ProductVersionStatus       @default(DRAFT)
  effectiveFrom           DateTime
  effectiveTo             DateTime?
  policySchema            Json
  exposureSchemas         Json
  pricingInputSchema      Json
  defaultCurrency         CurrencyCode               @default(SEK)
  allowedCurrencies       CurrencyCode[]             @default([SEK])
  pricingProgramVersionId String?                    @db.Uuid
  activatedAt             DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  product                 Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  pricingProgramVersion   PricingProgramVersion?     @relation(fields: [pricingProgramVersionId], references: [id], onDelete: Restrict)
  snapshot                ProductVersionSnapshot?
  componentRefs           ProductVersionComponentRef[]
  pricingRuns             PricingRun[]

  @@unique([productId, version])
}

model ProductVersionSnapshot {
  id               String         @id @default(uuid()) @db.Uuid
  productVersionId String         @unique @db.Uuid
  resolvedSnapshot Json
  createdAt        DateTime       @default(now())
  productVersion   ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
}

model Component {
  id            String             @id @default(uuid()) @db.Uuid
  componentCode String             @unique
  type          ComponentType
  name          String
  description   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  versions      ComponentVersion[]
}

model ComponentVersion {
  id           String                     @id @default(uuid()) @db.Uuid
  componentId  String                     @db.Uuid
  version      Int
  status       ComponentVersionStatus     @default(DRAFT)
  schema       Json
  metadata     Json
  releasedAt   DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  component    Component                  @relation(fields: [componentId], references: [id], onDelete: Restrict)
  productRefs  ProductVersionComponentRef[]

  @@unique([componentId, version])
}

model ProductVersionComponentRef {
  id                 String           @id @default(uuid()) @db.Uuid
  productVersionId   String           @db.Uuid
  componentVersionId String           @db.Uuid
  configOverrides    Json
  createdAt          DateTime         @default(now())
  productVersion     ProductVersion   @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  componentVersion   ComponentVersion @relation(fields: [componentVersionId], references: [id], onDelete: Restrict)

  @@unique([productVersionId, componentVersionId])
}

model PricingProgram {
  id          String                  @id @default(uuid()) @db.Uuid
  programCode String                  @unique
  name        String
  description String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  versions    PricingProgramVersion[]
}

model PricingProgramVersion {
  id              String                      @id @default(uuid()) @db.Uuid
  pricingProgramId String                     @db.Uuid
  version         Int
  status          PricingProgramVersionStatus @default(DRAFT)
  fileRef         String
  inputSchema     Json
  outputSchema    Json
  metadata        Json
  releasedAt      DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  pricingProgram  PricingProgram              @relation(fields: [pricingProgramId], references: [id], onDelete: Restrict)
  productVersions ProductVersion[]
  pricingRuns     PricingRun[]

  @@unique([pricingProgramId, version])
}

model PricingRun {
  id                      String                @id @default(uuid()) @db.Uuid
  requestId               String                @unique
  productVersionId        String                @db.Uuid
  pricingProgramVersionId String                @db.Uuid
  requestJson             Json
  responseJson            Json
  occurredAt              DateTime              @default(now())
  durationMs              Int
  currency                CurrencyCode
  success                 Boolean
  failureReason           String?
  productVersion          ProductVersion        @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  pricingProgramVersion   PricingProgramVersion @relation(fields: [pricingProgramVersionId], references: [id], onDelete: Restrict)

  @@index([productVersionId, occurredAt])
  @@index([pricingProgramVersionId, occurredAt])
}

model Policy {
  id           String              @id @default(uuid()) @db.Uuid
  policyNumber String              @unique
  status       PolicyStatus        @default(DRAFT)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  terms        PolicyTerm[]
  transactions PolicyTransaction[]
  exposures    PolicyExposureRecord[]
  coverages    PolicyCoverageRecord[]
}

model PolicyTerm {
  id            String                 @id @default(uuid()) @db.Uuid
  policyId      String                 @db.Uuid
  termNumber    Int
  status        PolicyTermStatus       @default(ACTIVE)
  effectiveFrom DateTime
  effectiveTo   DateTime
  createdAt     DateTime               @default(now())
  policy        Policy                 @relation(fields: [policyId], references: [id], onDelete: Restrict)
  transactions  PolicyTransaction[]
  exposures     PolicyExposureRecord[]
  coverages     PolicyCoverageRecord[]

  @@unique([policyId, termNumber])
}

model PolicyTransaction {
  id                      String                  @id @default(uuid()) @db.Uuid
  policyId                String                  @db.Uuid
  policyTermId            String?                 @db.Uuid
  transactionNumber       Int
  transactionType         PolicyTransactionType
  status                  PolicyTransactionStatus @default(DRAFT)
  effectiveFrom           DateTime
  effectiveTo             DateTime
  productVersionId        String                  @db.Uuid
  pricingProgramVersionId String?                 @db.Uuid
  draftPayload            Json
  ratingRequestJson       Json?
  ratingResponseJson      Json?
  ratedAt                 DateTime?
  committedAt             DateTime?
  createdAt               DateTime                @default(now())
  policy                  Policy                  @relation(fields: [policyId], references: [id], onDelete: Restrict)
  policyTerm              PolicyTerm?             @relation(fields: [policyTermId], references: [id], onDelete: Restrict)
  exposures               PolicyExposureRecord[]
  coverages               PolicyCoverageRecord[]

  @@unique([policyId, transactionNumber])
}

model PolicyExposureRecord {
  id                  String            @id @default(uuid()) @db.Uuid
  policyId            String            @db.Uuid
  policyTermId        String            @db.Uuid
  policyTransactionId String            @db.Uuid
  exposureKey         String
  data                Json
  effectiveFrom       DateTime
  effectiveTo         DateTime
  createdAt           DateTime          @default(now())
  policy              Policy            @relation(fields: [policyId], references: [id], onDelete: Restrict)
  policyTerm          PolicyTerm        @relation(fields: [policyTermId], references: [id], onDelete: Restrict)
  policyTransaction   PolicyTransaction @relation(fields: [policyTransactionId], references: [id], onDelete: Restrict)

  @@index([policyId, effectiveFrom, effectiveTo])
  @@index([policyId, exposureKey, effectiveFrom, effectiveTo])
}

model PolicyCoverageRecord {
  id                  String            @id @default(uuid()) @db.Uuid
  policyId            String            @db.Uuid
  policyTermId        String            @db.Uuid
  policyTransactionId String            @db.Uuid
  coverageKey         String
  data                Json
  effectiveFrom       DateTime
  effectiveTo         DateTime
  createdAt           DateTime          @default(now())
  policy              Policy            @relation(fields: [policyId], references: [id], onDelete: Restrict)
  policyTerm          PolicyTerm        @relation(fields: [policyTermId], references: [id], onDelete: Restrict)
  policyTransaction   PolicyTransaction @relation(fields: [policyTransactionId], references: [id], onDelete: Restrict)

  @@index([policyId, effectiveFrom, effectiveTo])
  @@index([policyId, coverageKey, effectiveFrom, effectiveTo])
}
