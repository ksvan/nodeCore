generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ProductVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ComponentType {
  COVERAGE
  EXPOSURE
  RULE
}

enum ComponentVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum PricingProgramVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum CurrencyCode {
  SEK
  DKK
  EUR
  GBP
  USD
  NOK
}

enum PolicyStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum PolicyTransactionType {
  NEW_BUSINESS
  ENDORSEMENT
}

enum PolicyTransactionStatus {
  DRAFT
  COMMITTED
}

enum PolicyTermStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum PolicyRiskType {
  VEHICLE
  PROPERTY
  LOCATION
  PERSON
  OTHER
}

enum CoverageTermValueType {
  MONEY
  NUMBER
  STRING
  BOOLEAN
}

enum BillingAccountStatus {
  ACTIVE
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentStatus {
  RECEIVED
  ALLOCATED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  roles        String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id          String          @id @default(uuid()) @db.Uuid
  productCode String          @unique
  name        String
  description String?
  status      ProductStatus   @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    ProductVersion[]
}

model ProductVersion {
  id                      String                     @id @default(uuid()) @db.Uuid
  productId               String                     @db.Uuid
  version                 Int
  status                  ProductVersionStatus       @default(DRAFT)
  effectiveFrom           DateTime
  effectiveTo             DateTime?
  policySchema            Json
  exposureSchemas         Json
  pricingInputSchema      Json
  defaultCurrency         CurrencyCode               @default(SEK)
  allowedCurrencies       CurrencyCode[]             @default([SEK])
  pricingProgramVersionId String?                    @db.Uuid
  activatedAt             DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  product                 Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  pricingProgramVersion   PricingProgramVersion?     @relation(fields: [pricingProgramVersionId], references: [id], onDelete: Restrict)
  snapshot                ProductVersionSnapshot?
  componentRefs           ProductVersionComponentRef[]
  pricingRuns             PricingRun[]

  @@unique([productId, version])
}

model ProductVersionSnapshot {
  id               String         @id @default(uuid()) @db.Uuid
  productVersionId String         @unique @db.Uuid
  resolvedSnapshot Json
  createdAt        DateTime       @default(now())
  productVersion   ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
}

model Component {
  id            String             @id @default(uuid()) @db.Uuid
  componentCode String             @unique
  type          ComponentType
  name          String
  description   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  versions      ComponentVersion[]
}

model ComponentVersion {
  id           String                     @id @default(uuid()) @db.Uuid
  componentId  String                     @db.Uuid
  version      Int
  status       ComponentVersionStatus     @default(DRAFT)
  schema       Json
  metadata     Json
  releasedAt   DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  component    Component                  @relation(fields: [componentId], references: [id], onDelete: Restrict)
  productRefs  ProductVersionComponentRef[]

  @@unique([componentId, version])
}

model ProductVersionComponentRef {
  id                 String           @id @default(uuid()) @db.Uuid
  productVersionId   String           @db.Uuid
  componentVersionId String           @db.Uuid
  configOverrides    Json
  createdAt          DateTime         @default(now())
  productVersion     ProductVersion   @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  componentVersion   ComponentVersion @relation(fields: [componentVersionId], references: [id], onDelete: Restrict)

  @@unique([productVersionId, componentVersionId])
}

model PricingProgram {
  id          String                  @id @default(uuid()) @db.Uuid
  programCode String                  @unique
  name        String
  description String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  versions    PricingProgramVersion[]
}

model PricingProgramVersion {
  id              String                      @id @default(uuid()) @db.Uuid
  pricingProgramId String                     @db.Uuid
  version         Int
  status          PricingProgramVersionStatus @default(DRAFT)
  fileRef         String
  inputSchema     Json
  outputSchema    Json
  metadata        Json
  releasedAt      DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  pricingProgram  PricingProgram              @relation(fields: [pricingProgramId], references: [id], onDelete: Restrict)
  productVersions ProductVersion[]
  pricingRuns     PricingRun[]

  @@unique([pricingProgramId, version])
}

model PricingRun {
  id                      String                @id @default(uuid()) @db.Uuid
  requestId               String                @unique
  productVersionId        String                @db.Uuid
  pricingProgramVersionId String                @db.Uuid
  requestJson             Json
  responseJson            Json
  occurredAt              DateTime              @default(now())
  durationMs              Int
  currency                CurrencyCode
  success                 Boolean
  failureReason           String?
  productVersion          ProductVersion        @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  pricingProgramVersion   PricingProgramVersion @relation(fields: [pricingProgramVersionId], references: [id], onDelete: Restrict)

  @@index([productVersionId, occurredAt])
  @@index([pricingProgramVersionId, occurredAt])
}

model Policy {
  id               String                @id @default(uuid()) @db.Uuid
  policyNumber     String                @unique
  status           PolicyStatus          @default(DRAFT)
  productId        String                @db.Uuid
  productVersionId String                @db.Uuid
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(6)
  terms            PolicyTerm[]
  transactions     PolicyTransaction[]
  risks            PolicyRisk[]
  coverages        PolicyCoverage[]
  premiums         PolicyPremium[]
  riskDrafts       PolicyRiskDraft[]
  coverageDrafts   PolicyCoverageDraft[]
  termDrafts       CoverageTermDraft[]
  idempotencyKeys  PolicyIdempotencyKey[]

  @@index([productId])
  @@index([productVersionId])
}

model PolicyTerm {
  id           String              @id @default(uuid()) @db.Uuid
  policyId     String              @db.Uuid
  termStart    DateTime            @db.Timestamptz(6)
  termEnd      DateTime            @db.Timestamptz(6)
  status       PolicyTermStatus    @default(ACTIVE)
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)
  policy       Policy              @relation(fields: [policyId], references: [id], onDelete: Restrict)
  transactions PolicyTransaction[]
  risks        PolicyRisk[]
  coverages    PolicyCoverage[]
  premiums     PolicyPremium[]
}

model PolicyTransaction {
  id             String                  @id @default(uuid()) @db.Uuid
  policyId       String                  @db.Uuid
  termId         String                  @db.Uuid
  type           PolicyTransactionType
  status         PolicyTransactionStatus @default(DRAFT)
  effectiveAt    DateTime                @db.Timestamptz(6)
  requestId      String?
  idempotencyKey String?
  createdAt      DateTime                @default(now()) @db.Timestamptz(6)
  committedAt    DateTime?               @db.Timestamptz(6)
  policy         Policy                  @relation(fields: [policyId], references: [id], onDelete: Restrict)
  term           PolicyTerm              @relation(fields: [termId], references: [id], onDelete: Restrict)
  risks          PolicyRisk[]
  coverages      PolicyCoverage[]
  terms          CoverageTerm[]
  premiums       PolicyPremium[]
  riskDrafts     PolicyRiskDraft[]
  coverageDrafts PolicyCoverageDraft[]
  termDrafts     CoverageTermDraft[]

  @@index([policyId, createdAt])
  @@index([policyId, effectiveAt])
  @@index([termId, createdAt])
  @@unique([policyId, idempotencyKey])
  @@unique([policyId, requestId])
}

model PolicyRisk {
  id                     String            @id @default(uuid()) @db.Uuid
  policyId               String            @db.Uuid
  termId                 String            @db.Uuid
  riskType               PolicyRiskType
  riskKey                String?
  attributes             Json
  effectiveFrom          DateTime          @db.Timestamptz(6)
  effectiveTo            DateTime          @db.Timestamptz(6)
  createdByTransactionId String            @db.Uuid
  createdAt              DateTime          @default(now()) @db.Timestamptz(6)
  policy                 Policy            @relation(fields: [policyId], references: [id], onDelete: Restrict)
  term                   PolicyTerm        @relation(fields: [termId], references: [id], onDelete: Restrict)
  createdByTransaction   PolicyTransaction @relation(fields: [createdByTransactionId], references: [id], onDelete: Restrict)
  coverages              PolicyCoverage[]
  premiums               PolicyPremium[]

  @@index([policyId, effectiveFrom, effectiveTo])
  @@index([policyId, riskType, effectiveFrom, effectiveTo])
  @@index([policyId, riskKey, effectiveFrom, effectiveTo])
}

model PolicyCoverage {
  id                     String            @id @default(uuid()) @db.Uuid
  policyId               String            @db.Uuid
  termId                 String            @db.Uuid
  coverageCode           String
  appliesToRiskId        String?           @db.Uuid
  attributes             Json
  effectiveFrom          DateTime          @db.Timestamptz(6)
  effectiveTo            DateTime          @db.Timestamptz(6)
  createdByTransactionId String            @db.Uuid
  createdAt              DateTime          @default(now()) @db.Timestamptz(6)
  policy                 Policy            @relation(fields: [policyId], references: [id], onDelete: Restrict)
  term                   PolicyTerm        @relation(fields: [termId], references: [id], onDelete: Restrict)
  appliesToRisk          PolicyRisk?       @relation(fields: [appliesToRiskId], references: [id], onDelete: Restrict)
  createdByTransaction   PolicyTransaction @relation(fields: [createdByTransactionId], references: [id], onDelete: Restrict)
  terms                  CoverageTerm[]
  premiums               PolicyPremium[]

  @@index([policyId, effectiveFrom, effectiveTo])
  @@index([policyId, coverageCode, effectiveFrom, effectiveTo])
}

model CoverageTerm {
  id                     String                @id @default(uuid()) @db.Uuid
  policyCoverageId       String                @db.Uuid
  termCode               String
  valueType              CoverageTermValueType
  moneyAmount            Decimal?              @db.Decimal(18, 2)
  moneyCurrency          String?               @db.Char(3)
  numberValue            Decimal?              @db.Decimal(18, 4)
  stringValue            String?
  booleanValue           Boolean?
  effectiveFrom          DateTime              @db.Timestamptz(6)
  effectiveTo            DateTime              @db.Timestamptz(6)
  createdByTransactionId String                @db.Uuid
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)
  policyCoverage         PolicyCoverage        @relation(fields: [policyCoverageId], references: [id], onDelete: Restrict)
  createdByTransaction   PolicyTransaction     @relation(fields: [createdByTransactionId], references: [id], onDelete: Restrict)

  @@index([policyCoverageId, effectiveFrom, effectiveTo])
  @@index([termCode, effectiveFrom, effectiveTo])
}

model PolicyPremium {
  id                     String            @id @default(uuid()) @db.Uuid
  policyId               String            @db.Uuid
  termId                 String            @db.Uuid
  coverageId             String?           @db.Uuid
  riskId                 String?           @db.Uuid
  totalAmount            Decimal           @db.Decimal(18, 2)
  currency               String            @db.Char(3)
  breakdown              Json?
  effectiveFrom          DateTime          @db.Timestamptz(6)
  effectiveTo            DateTime          @db.Timestamptz(6)
  createdByTransactionId String            @db.Uuid
  createdAt              DateTime          @default(now()) @db.Timestamptz(6)
  policy                 Policy            @relation(fields: [policyId], references: [id], onDelete: Restrict)
  term                   PolicyTerm        @relation(fields: [termId], references: [id], onDelete: Restrict)
  coverage               PolicyCoverage?   @relation(fields: [coverageId], references: [id], onDelete: Restrict)
  risk                   PolicyRisk?       @relation(fields: [riskId], references: [id], onDelete: Restrict)
  createdByTransaction   PolicyTransaction @relation(fields: [createdByTransactionId], references: [id], onDelete: Restrict)

  @@index([policyId, effectiveFrom, effectiveTo])
}

model PolicyRiskDraft {
  id            String            @id @default(uuid()) @db.Uuid
  policyId      String            @db.Uuid
  transactionId String            @db.Uuid
  riskType      PolicyRiskType
  riskKey       String?
  attributes    Json
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  policy        Policy            @relation(fields: [policyId], references: [id], onDelete: Restrict)
  transaction   PolicyTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId, createdAt])
}

model PolicyCoverageDraft {
  id               String            @id @default(uuid()) @db.Uuid
  policyId         String            @db.Uuid
  transactionId    String            @db.Uuid
  coverageCode     String
  appliesToRiskKey String?
  attributes       Json
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  policy           Policy            @relation(fields: [policyId], references: [id], onDelete: Restrict)
  transaction      PolicyTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  terms            CoverageTermDraft[]

  @@index([transactionId, createdAt])
}

model CoverageTermDraft {
  id               String                @id @default(uuid()) @db.Uuid
  policyId         String                @db.Uuid
  transactionId    String                @db.Uuid
  policyCoverageDraftId String           @db.Uuid
  termCode         String
  valueType        CoverageTermValueType
  moneyAmount      Decimal?              @db.Decimal(18, 2)
  moneyCurrency    String?               @db.Char(3)
  numberValue      Decimal?              @db.Decimal(18, 4)
  stringValue      String?
  booleanValue     Boolean?
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  policy           Policy                @relation(fields: [policyId], references: [id], onDelete: Restrict)
  transaction      PolicyTransaction     @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  policyCoverageDraft PolicyCoverageDraft @relation(fields: [policyCoverageDraftId], references: [id], onDelete: Restrict)

  @@index([transactionId, createdAt])
}

model PolicyIdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  policyId       String?  @db.Uuid
  commandScope   String
  idempotencyKey String
  responseJson   Json
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  policy         Policy?  @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@unique([commandScope, idempotencyKey])
  @@index([policyId, createdAt])
}

model BillingAccount {
  id        String               @id @default(uuid()) @db.Uuid
  partyId   String               @db.Uuid
  status    BillingAccountStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  invoices  Invoice[]
  payments  Payment[]
  auditLogs BillingAuditLog[]

  @@index([partyId])
}

model Invoice {
  id               String          @id @default(uuid()) @db.Uuid
  billingAccountId String          @db.Uuid
  invoiceNumber    String          @unique
  status           InvoiceStatus   @default(POSTED)
  currency         CurrencyCode
  dueDate          DateTime
  totalAmount      Decimal         @db.Decimal(18, 2)
  postedAt         DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  billingAccount   BillingAccount  @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  lines            InvoiceLine[]
  allocations      PaymentAllocation[]

  @@index([billingAccountId, createdAt])
}

model InvoiceLine {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  description String
  quantity    Decimal  @db.Decimal(18, 4)
  unitAmount  Decimal  @db.Decimal(18, 2)
  lineTotal   Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, createdAt])
}

model Payment {
  id               String             @id @default(uuid()) @db.Uuid
  billingAccountId String             @db.Uuid
  amount           Decimal            @db.Decimal(18, 2)
  currency         CurrencyCode
  status           PaymentStatus      @default(RECEIVED)
  providerRef      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  billingAccount   BillingAccount     @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  allocations      PaymentAllocation[]

  @@index([billingAccountId, createdAt])
}

model PaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @db.Uuid
  invoiceId String   @db.Uuid
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId, createdAt])
}

model BillingIdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  commandScope String
  idempotencyKey String
  responseJson Json
  createdAt    DateTime @default(now())

  @@unique([commandScope, idempotencyKey])
}

model BillingAuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  billingAccountId String?  @db.Uuid
  entityType       String
  entityId         String   @db.Uuid
  action           String
  data             Json
  createdAt        DateTime @default(now())
  billingAccount   BillingAccount? @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)

  @@index([billingAccountId, createdAt])
  @@index([entityType, entityId, createdAt])
}
